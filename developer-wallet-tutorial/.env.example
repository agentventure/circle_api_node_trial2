# Circle API Credentials (Required)
# Get these from your Circle Developer Console: https://console.circle.com/
CIRCLE_API_KEY=TEST_API_KEY:your_api_key_here:your_api_key_suffix_here
CIRCLE_ENTITY_SECRET=your_entity_secret_here

# Transaction Parameters (Required for transaction creation)
# Replace with your actual wallet ID that has MATIC funds on Polygon Amoy testnet
WALLET_ID=your_wallet_id_here

# Destination address for transactions
DESTINATION_ADDRESS=0x742d35Cc6634C0532925a3b8D4C9db96590c6C8b

# Token to transfer (MATIC for Polygon Amoy testnet)
TOKEN_ID=36b6931a-873a-56a8-8a27-b706b17104ee

# Amount to transfer (eg. in USDC.)
AMOUNT=0.001